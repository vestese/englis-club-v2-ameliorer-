{
  "version": 2,
  "name": "club-anglais-accra",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/validate-word",
      "dest": "/api/validate-word.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
